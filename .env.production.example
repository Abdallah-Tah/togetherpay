# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env on production servers and configure all values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=TogetherPay
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.togetherpay.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

# Security: Use at least 12 rounds for production
BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =============================================================================
# DATABASE - PRODUCTION (PostgreSQL Recommended)
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=your-postgres-host.example.com
DB_PORT=5432
DB_DATABASE=togetherpay_production
DB_USERNAME=togetherpay_user
DB_PASSWORD=

# For read replicas (optional)
# DB_READ_HOST=your-postgres-read-replica.example.com

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.togetherpay.app
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# =============================================================================
# CACHE & QUEUE (Production: Use Redis)
# =============================================================================
CACHE_STORE=redis
CACHE_PREFIX=togetherpay_cache

QUEUE_CONNECTION=redis

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=your-redis-host.example.com
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# =============================================================================
# MAIL CONFIGURATION (Production)
# =============================================================================
MAIL_MAILER=ses
MAIL_SCHEME=https
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@togetherpay.app"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=togetherpay-production
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# FILE STORAGE (Production: Use S3)
# =============================================================================
FILESYSTEM_DISK=s3

# =============================================================================
# SANCTUM API AUTHENTICATION
# =============================================================================
SANCTUM_STATEFUL_DOMAINS=togetherpay.app,www.togetherpay.app
SANCTUM_TOKEN_LIFETIME=525600

# Frontend URL for CORS and redirects
FRONTEND_URL=https://togetherpay.app

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ALLOWED_ORIGINS=https://togetherpay.app,https://www.togetherpay.app
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=3600
CORS_SUPPORTS_CREDENTIALS=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=5

# =============================================================================
# PAYMENT PROVIDERS
# =============================================================================
# Payment Request Driver (link or api)
PR_DRIVER=link

# Cash App Configuration
CASHAPP_CLIENT_ID=
CASHAPP_CLIENT_SECRET=
CASHAPP_REDIRECT_URI=https://api.togetherpay.app/api/v1/cashapp/oauth/callback
CASHAPP_ENVIRONMENT=production

# Venmo Configuration (Future)
VENMO_CLIENT_ID=
VENMO_CLIENT_SECRET=

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Twilio (SMS Notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVER_KEY=
FCM_SENDER_ID=

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Sentry Error Tracking
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Application Performance Monitoring
APM_ENABLED=true
APM_SERVICE_NAME=togetherpay-api
APM_ENVIRONMENT=production

# =============================================================================
# SECURITY HEADERS
# =============================================================================
SECURITY_HSTS_ENABLE=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_CSP_ENABLE=true

# =============================================================================
# HORIZON (Queue Dashboard)
# =============================================================================
HORIZON_BASIC_AUTH=true
HORIZON_USERNAME=admin
HORIZON_PASSWORD=

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=30

# =============================================================================
# FEATURES FLAGS
# =============================================================================
FF_PAYMENT_API=false
FF_SMS=true
FF_PDF_EXPORTS=true

# =============================================================================
# BROADCASTING
# =============================================================================
BROADCAST_CONNECTION=pusher
BROADCAST_DRIVER=pusher

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=us2

# =============================================================================
# MAINTENANCE MODE
# =============================================================================
MAINTENANCE_ALLOWED_IPS=

# =============================================================================
# VITE (For Asset Building)
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
