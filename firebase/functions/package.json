{
  "name": "togetherpay-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for TogetherPay Firebase backend",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint --ext .ts src",
    "serve": "npm run build && firebase emulators:start --only functions",
